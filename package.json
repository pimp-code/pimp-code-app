{
  "name": "pimp-code-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:agent": "npm run build -w @pimp-code/agent-host",
    "build:desktop": "npm run build:agent && node scripts/run-tauri.mjs build",
    "dev": "npm run build:agent && node scripts/run-tauri.mjs dev",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
