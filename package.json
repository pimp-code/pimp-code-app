{
  "name": "pimp-code-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "node scripts/run-workspace-sequence.mjs build",
    "build:skills": "npm run build -w @pimp-code/skill-runtime",
    "build:agent:only": "npm run build -w @pimp-code/agent-host",
    "build:agent": "node scripts/run-workspace-sequence.mjs build-agent",
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop:restart": "node scripts/run-desktop-release-restart-smoke.mjs",
    "dev": "node scripts/run-workspace-sequence.mjs dev",
    "test": "node scripts/run-workspace-sequence.mjs test",
    "typecheck": "node scripts/run-workspace-sequence.mjs typecheck"
  },
  "devDependencies": {
    "@wdio/tauri-service": "^1.3.0",
    "esbuild": "^0.28.2"
  }
}
