# Direct Claude provider. Never expose this value to the renderer.
ANTHROPIC_API_KEY=

# Optional API key forwarded only to the configured local OpenAI-compatible endpoint.
LOCAL_LLM_API_KEY=

# Disables non-essential Claude Code traffic during the spike.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
